# copy this file to .env and fill in your own values
# if left empty, the agent runs in offline rule-based fallback mode (still uses real tools/memory)

# Option 1 (recommended, simplest): Groq - free, OpenAI-compatible, no credit card
# get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Option 2: Azure/Microsoft Foundry (used only if GROQ_API_KEY is not set)
# get these from your Foundry project's "Use a model" page
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
